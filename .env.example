# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored and must NEVER be committed.
# The app loads it automatically via `node --env-file=.env` (see package.json).
# ---------------------------------------------------------------------------

# Anthropic — powers the adaptive interview and the match explanations.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model used for the interview / ranking.
# Defaults to a sensible current model if left blank.
ANTHROPIC_MODEL=

# Adzuna job search API — https://developer.adzuna.com/
# Requires BOTH an application id and key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country marketplace to search (gb, us, de, se, ...). Defaults to gb.
ADZUNA_COUNTRY=gb

# JobTech Dev (Swedish Public Employment Service) JobSearch API.
# This API is OPEN and requires NO key — listed here only for documentation.
# Base URL is configured in code; override here only if it ever changes.
JOBTECH_BASE_URL=https://jobsearch.api.jobtechdev.se

# Logging verbosity: error | warn | info | debug
LOG_LEVEL=info
