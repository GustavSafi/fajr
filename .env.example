# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored and must NEVER be committed.
# The app loads it automatically via `node --env-file-if-exists=.env`.
#
# The interview is fully rule-based and needs NO keys. These are only for the
# job-search providers (used in later steps).
# ---------------------------------------------------------------------------

# Adzuna job search API — https://developer.adzuna.com/
# Requires BOTH an application id and key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country marketplace to search (gb, us, de, se, ...). Defaults to gb.
ADZUNA_COUNTRY=gb

# JobTech Dev (Swedish Public Employment Service) JobSearch API.
# This API is OPEN and requires NO key — listed here only for documentation.
# Override only if the base URL ever changes.
JOBTECH_BASE_URL=https://jobsearch.api.jobtechdev.se

# Logging verbosity: error | warn | info | debug
LOG_LEVEL=info
